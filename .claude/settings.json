{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/session_start.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_no_personal_data.py\" --hook"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_or_update_file|mcp__github__push_files",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_no_personal_data.py\" --hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest:*)",
      "Bash(./life:*)",
      "Bash(python3 ./life:*)",
      "Bash(python3 scripts/check_no_personal_data.py:*)",
      "Bash(python3 scripts/session_start.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "WebSearch",
      "WebFetch",
      "mcp__Gmail__search_threads",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__get_message",
      "mcp__Gmail__list_labels",
      "mcp__Gmail__list_drafts",
      "mcp__Gmail__get_draft",
      "mcp__Google_Calendar__list_calendars",
      "mcp__Google_Calendar__list_events",
      "mcp__Google_Calendar__get_event",
      "mcp__Google_Calendar__search_events",
      "mcp__Notion__notion-search",
      "mcp__Notion__notion-fetch",
      "mcp__Notion__notion-query-data-sources",
      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__list_recent_files"
    ],
    "ask": [
      "mcp__Gmail__send_message",
      "mcp__Gmail__reply",
      "mcp__Gmail__forward",
      "mcp__Gmail__trash_message",
      "mcp__Gmail__trash_thread",
      "mcp__Google_Calendar__delete_event",
      "mcp__Google_Drive__share_file",
      "mcp__Google_Drive__trash_file",
      "mcp__Notion__notion-delete-pages",
      "mcp__Notion__notion-delete-databases"
    ]
  }
}
